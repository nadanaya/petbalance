{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt && npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{legacy/**,design/**,desktop/**,release/**,build/**,shelter/**,shelter-scaffold/**,tests/**,docs/**,reports/**,sql/**,node_modules/**,frontend/node_modules/**,frontend/src/**,.next/**}"
    }
  }
}
